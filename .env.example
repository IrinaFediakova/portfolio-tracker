# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.

# --- Public (safe for the browser; protected by Row Level Security) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only (NEVER prefix with NEXT_PUBLIC_) -----------------------------
# Used exclusively by `npm run seed`. Bypasses RLS: keep it out of app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo account: created by the seed script, used by "Continue as demo user".
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me-to-a-strong-password
